# 部署目标配置示例（占位值）。复制为 deploy/remote/targets/<名字>.env 再按实际修改；
# targets/ 目录不进 Git。换服务器只需新建一份目标配置，再执行 deploy/remote/yika.sh <名字> deploy。
# 这里不放任何密码与密钥：数据库密码、主密钥、管理员初始密码由服务器首次部署时生成，保存在服务器 /etc/yika/secrets.env。

# ---- SSH ----
SSH_HOST=203.0.113.10            # IP、域名或 ~/.ssh/config 里的别名
SSH_USER=root
SSH_PORT=22
SSH_KEY=~/.ssh/id_ed25519        # 留空则用 ssh 默认密钥 / ~/.ssh/config

# ---- 对外地址与端口 ----
PUBLIC_HOST=203.0.113.10         # 用户访问前台、客户端连接代理使用的地址（IP 或域名）
PORTAL_PORT=36443                # 用户前台 HTTPS
ADMIN_PORT=37443                 # 管理后台 HTTPS
CONTROL_HTTP_PORT=38080          # 控制面 HTTP，只监听本机，由 nginx 转发
AGENT_PORT=38443                 # 节点 mTLS 接口
AGENT_LISTEN_HOST=127.0.0.1      # 单机部署只监听本机；以后加外部节点改为 0.0.0.0（会放行防火墙）
PROXY_PORT_START=41000           # 代理接入端口池（首次登记节点时生效，之后不改）
PROXY_PORT_END=41999

# ---- 本机节点 ----
NODE_NAME=node-01                # 首次登记时使用，之后在后台改
DIRECT_REGION_CODE=hk            # 服务器直出的出口地域（两位国家/地区代码，首次登记时写入，之后在后台改）
DIRECT_REGION_NAME=香港

# ---- 业务 ----
BRAND=驿卡
ADMIN_EMAIL=admin@example.com    # 首个管理员的登录邮箱（只在首次部署时创建）
ECHO_URL=https://api.ipify.org   # 出口检测用的 IP 回显端点（返回纯文本 IP）
# 出口国家识别：探测只回报出口 IP，控制面查 IP 归属地判定“国家符合套餐”，国家不符的出口不会分配给用户。
# dbip（默认）：部署时下载 DB-IP 免费国家库，每月 3 日自动更新；off：不用归属地库，只看下面的手工映射。
GEOIP=dbip
# 手工映射，优先于归属地库，用来纠正判错的个别 IP，或 GEOIP=off 时逐个指定。
# 空格分隔，可写单个 IP 或网段，形如 "198.51.100.7=us 2001:db8::/48=jp"。一般留空。
EXIT_COUNTRIES=""

# ---- 邮件 ----
# file：邮件写到服务器 /var/lib/isp-control/mail（用 yika.sh <目标> mail 查看）；smtp：真实发送。
MAIL_MODE=file
# Gmail：只填 SMTP_USERNAME（Gmail 地址）与 SMTP_PASSWORD（16 位应用专用密码；带空格时加双引号）即可，
# 服务器与发件人自动补全为 smtp.gmail.com:587 STARTTLS、“驿卡 <该地址>”。
# 应用专用密码：账号先开两步验证，再到 https://myaccount.google.com/apppasswords 生成（不是 Gmail 登录密码）。
# Outlook / Hotmail 个人邮箱不能用（微软已停用 SMTP 密码认证）。
SMTP_USERNAME=
SMTP_PASSWORD=
# 其他服务商才需要填（留空 = 按上面自动补全）：
SMTP_ADDR=                       # 如 smtp.example.com:587
SMTP_SECURITY=                   # starttls（默认）、tls（465）或 plain
MAIL_FROM=                       # 如 "驿卡 <no-reply@example.com>"，留空 = 发信账号本身
# SMTP_PASSWORD 只留在本机这份目标配置里（targets/ 不进 Git）；部署时经 ssh 写入服务器 /etc/yika/secrets.env，
# 不会出现在服务器的 /etc/yika/target.env 与命令行参数里。

# ---- 网站证书（可选）----
# 留空：服务器自签证书（浏览器首次访问需手动信任）。有域名后填本机上的证书文件路径（完整链 + 私钥）。
TLS_CERT_FILE=
TLS_KEY_FILE=
