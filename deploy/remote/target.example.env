# 部署目标配置示例（占位值）。复制为 deploy/remote/targets/<名字>.env 再按实际修改；
# targets/ 目录不进 Git。换服务器只需新建一份目标配置，再执行 deploy/remote/yika.sh <名字> deploy。
# 这里不放任何密码与密钥：数据库密码、主密钥、管理员初始密码由服务器首次部署时生成，保存在服务器 /etc/yika/secrets.env。

# ---- SSH ----
SSH_HOST=203.0.113.10            # IP、域名或 ~/.ssh/config 里的别名
SSH_USER=root
SSH_PORT=22
SSH_KEY=~/.ssh/id_ed25519        # 留空则用 ssh 默认密钥 / ~/.ssh/config

# ---- 对外地址与端口 ----
PUBLIC_HOST=203.0.113.10         # 用户访问前台、客户端连接代理使用的地址（IP 或域名）
PORTAL_PORT=36443                # 用户前台 HTTPS
ADMIN_PORT=37443                 # 管理后台 HTTPS
CONTROL_HTTP_PORT=38080          # 控制面 HTTP，只监听本机，由 nginx 转发
AGENT_PORT=38443                 # 节点 mTLS 接口
AGENT_LISTEN_HOST=127.0.0.1      # 单机部署只监听本机；以后加外部节点改为 0.0.0.0（会放行防火墙）
PROXY_PORT_START=41000           # 代理接入端口池（首次登记节点时生效，之后不改）
PROXY_PORT_END=41999

# ---- 本机节点 ----
NODE_NAME=node-01                # 首次登记时使用，之后在后台改
DIRECT_REGION_CODE=hk            # 服务器直出的出口地域（两位国家/地区代码，首次登记时写入，之后在后台改）
DIRECT_REGION_NAME=香港

# ---- 业务 ----
BRAND=驿卡
ADMIN_EMAIL=admin@example.com    # 首个管理员的登录邮箱（只在首次部署时创建）
ECHO_URL=https://api.ipify.org   # 出口检测用的 IP 回显端点（返回纯文本 IP）
# 出口 IP → 国家代码（空格分隔，形如 "198.51.100.7=us 198.51.100.8=jp"）。
# 探测只回报出口 IP，控制面据此判定“国家符合套餐”；没列出的出口检测不通过、不会分配给用户。
EXIT_COUNTRIES=""

# ---- 邮件 ----
MAIL_MODE=file                   # file：邮件写到服务器 /var/lib/isp-control/mail（用 yika.sh <目标> mail 查看）；smtp：真实发送
MAIL_FROM="驿卡 <no-reply@example.com>"
SMTP_ADDR=smtp.example.com:587
SMTP_SECURITY=starttls           # starttls、tls 或 plain
SMTP_USERNAME=no-reply@example.com
# SMTP 密码不写这里：在服务器 /etc/yika/secrets.env 里设置 SMTP_PASSWORD=…，再执行一次 deploy。

# ---- 网站证书（可选）----
# 留空：服务器自签证书（浏览器首次访问需手动信任）。有域名后填本机上的证书文件路径（完整链 + 私钥）。
TLS_CERT_FILE=
TLS_KEY_FILE=
